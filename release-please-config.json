{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "5aa888cebc34808eae74f7f5f31eb4dede5dc69d",
  "packages": {
    ".": {
      "release-type": "node",
      "versioning": "always-bump-patch",
      "component": "marketing-harness",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/bb-app/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        }
      ],
      "pull-request-title-pattern": "chore: release${component} ${version}",
      "pull-request-header": "This PR is updated after changes land on main. Review the generated notes and add the release date and headline to the web and app changelog metadata before merging.",
      "pull-request-footer": "> AGENT GENERATED: by release-please"
    }
  }
}
